{
  "permissions": {
    "additionalDirectories": [".."]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-commit-signing.sh",
            "timeout": 30,
            "statusMessage": "Checking commit signing..."
          }
        ]
      }
    ]
  }
}
